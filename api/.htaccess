# Geen mappenoverzicht en interne bestanden niet opvraagbaar
Options -Indexes
<FilesMatch "^(config|config\.example|lib)\.php$|\.(sql|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
